{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/vendor/prisma/client": ["lib/vendor/prisma/client/client"]
    }
  },
  "include": [
    "next-env.d.ts",
    "imageLoader.ts",
    "instrumentation.ts",
    "next.config.ts",
    "prisma.config.ts",
    "proxy.ts",
    "actions/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.d.ts",
    "types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/build",
    ".next/cache",
    ".next/dev/build",
    ".next/dev/cache",
    ".next/dev/logs",
    ".next/dev/node_modules",
    ".next/dev/server",
    ".next/dev/static",
    ".next/server",
    ".next/static",
    "coverage",
    "dist",
    "tmp"
  ]
}
