  "name": "shipyardhq",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "npm run build && npm run prisma:seed",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:migrate:reset": "prisma migrate reset --force",
