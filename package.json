{
  "name": "shipyardhq",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    },
    "@tootallnate/once": "^2.0.1",
    "engine.io-client": {
      "ws": "^8.20.1"
    },
    "eslint-plugin-react-hooks": "7.0.1",
    "glob": {
      "minimatch": "^9.0.7"
    },
    "lodash": "^4.18.1",
    "next": "$next",
    "next@16.2.6": {
      "postcss": "8.5.15"
    },
    "postcss": "$postcss",
    "protobufjs": "^7.6.1",
    "socket.io-client": {
      "engine.io-client": "^6.6.5",
      "socket.io-parser": "^4.2.6"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "analyze": "next experimental-analyze --output",
    "build:ci": "npm run build && npm run prisma:seed",
    "start": "next start",
    "admin:insights": "tsx scripts/admin-insights.ts",
    "admin:prod": "scripts/admin-insights-prod.sh",
    "worker": "tsx bin/shipyard-worker.ts",
    "images:ingest-external": "tsx scripts/ingest-external-images-to-r2.ts",
    "images:ingest-external:apply": "tsx scripts/ingest-external-images-to-r2.ts --apply",
    "browsers:update": "npx update-browserslist-db@latest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:dev": "tsx prisma/seed.dev.ts",
    "prisma:seed:categories": "tsx prisma/seed.categories.ts",
    "prisma:seed:usecases": "tsx prisma/seed.use-cases.ts",
    "prisma:seed:plan-features": "tsx prisma/seed.plan-features.ts",
    "prisma:seed:plans": "tsx prisma/seed.plans.ts",
    "prisma:seed:alternatives": "tsx prisma/seed.alternatives.ts",
    "prisma:seed:prod": "npm run prisma:seed:categories && npm run prisma:seed:usecases && npm run prisma:seed:plan-features",
    "postinstall": "npm run prisma:deploy",
    "prisma:seed:rewards": "tsx prisma/seed.rewards.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1072.0",
    "@clerk/nextjs": "^7.5.5",
    "@google-analytics/data": "^6.1.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/env": "^16.2.9",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tabler/icons-react": "^3.44.0",
    "bullmq": "^5.79.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dodopayments": "^2.39.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-seo": "^7.2.0",
    "openai": "^6.44.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "redis": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.3",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
