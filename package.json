{
  "name": "shipyardhq",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "npm run build && npm run prisma:seed",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:init": "grep '^DATABASE_URL=' .env.local > .env",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate --no-engine",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:categories": "tsx prisma/seed.categories.ts",
    "prisma:seed:usecases": "tsx prisma/seed.use-cases.ts",
    "prisma:seed:plan-features": "tsx prisma/seed.plan-features.ts",
    "prisma:seed:plans": "tsx prisma/seed.plans.ts",
    "prisma:seed:prod": "npm run prisma:seed:categories && npm run prisma:seed:usecases && npm run prisma:seed:plan-features",
    "postinstall": "npm run prisma:deploy",
    "test": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "prisma:seed:rewards": "tsx prisma/seed.rewards.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.7",
    "@clerk/themes": "^2.4.28",
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.0.0",
    "@prisma/client": "^6.17.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/render": "^1.4.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.0.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dodopayments": "^2.2.1",
    "googleapis": "^164.1.0",
    "jsonrepair": "^3.13.1",
    "lucide-react": "^0.546.0",
    "next": "^16.0.0",
    "openai": "^6.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "redis": "^5.8.3",
    "remark-gfm": "^4.0.1",
    "resend": "^6.2.2",
    "sharp": "^0.34.4",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "twitter-api-v2": "^1.27.0",
    "xml2js": "^0.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@clerk/testing": "^1.13.7",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.15",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  }
}
