{
  "name": "shipyardhq",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    },
    "@tootallnate/once": "^2.0.1",
    "engine.io-client": {
      "ws": "^8.20.1"
    },
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": {
      "minimatch": "^9.0.7"
    },
    "lodash": "^4.18.1",
    "next": "$next",
    "postcss": "$postcss",
    "protobufjs": "^7.6.1",
    "socket.io-client": {
      "engine.io-client": "^6.6.5",
      "socket.io-parser": "^4.2.6"
    },
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.4"
    },
    "braces": "$braces"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/prepare-standalone-assets.mjs",
    "analyze": "next experimental-analyze --output",
    "build:ci": "npm run build && npm run prisma:seed",
    "start": "next start",
    "admin:insights": "tsx scripts/admin-insights.ts",
    "admin:prod": "scripts/admin-insights-prod.sh",
    "analytics:backfill": "tsx scripts/backfill-analytics.ts",
    "billing:reconcile-product-grants": "tsx scripts/reconcile-product-plan-grants.ts",
    "release:image": "scripts/release-image.sh",
    "worker": "tsx bin/shipyard-worker.ts",
    "images:ingest-external": "tsx scripts/ingest-external-images-to-r2.ts",
    "images:ingest-external:apply": "tsx scripts/ingest-external-images-to-r2.ts --apply",
    "browsers:update": "npx update-browserslist-db@latest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tools",
    "typecheck:diagnostics": "tsc --noEmit --extendedDiagnostics --pretty false",
    "typecheck:files": "tsc --noEmit --listFilesOnly --pretty false",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:dev": "tsx prisma/seed.dev.ts",
    "prisma:seed:categories": "tsx prisma/seed.categories.ts",
    "prisma:seed:usecases": "tsx prisma/seed.use-cases.ts",
    "prisma:seed:plan-features": "tsx prisma/seed.plan-features.ts",
    "prisma:seed:plans": "tsx prisma/seed.plans.ts",
    "prisma:seed:alternatives": "tsx prisma/seed.alternatives.ts",
    "prisma:seed:prod": "npm run prisma:seed:categories && npm run prisma:seed:usecases && npm run prisma:seed:plan-features",
    "postinstall": "npm run prisma:deploy",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run && npm run test:dependency-security && npm run test:release-contract",
    "test:release-contract": "python3 scripts/ci/test-release-contract.py",
    "test:dependency-security": "node --test scripts/check-braces.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@clerk/nextjs": "^7.9.19",
    "@dualmark/converters": "^0.11.0",
    "@dualmark/core": "^0.11.0",
    "@dualmark/nextjs": "^0.11.0",
    "@hookform/resolvers": "^6.0.0",
    "@next/env": "^16.4.2",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@pyroscope/nodejs": "^0.7.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.49.0",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dodopayments": "^2.56.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-seo": "^7.3.0",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "redis": "^6.3.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "braces": "file:packages/braces"
  }
}
