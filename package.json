{
  "name": "shipyardhq",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@protobufjs/utf8": "^1.1.1",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    },
    "@tootallnate/once": "^2.0.1",
    "engine.io-client": {
      "ws": "^8.20.1"
    },
    "eslint-plugin-react-hooks": "7.0.1",
    "glob": {
      "minimatch": "^9.0.7"
    },
    "lodash": "^4.18.1",
    "next": "$next",
    "next@16.2.6": {
      "postcss": "8.5.15"
    },
    "postcss": "^8.5.19",
    "protobufjs": "^7.6.1",
    "socket.io-client": {
      "engine.io-client": "^6.6.5",
      "socket.io-parser": "^4.2.6"
    },
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.4"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/prepare-faro-sourcemaps.mjs && node scripts/prepare-standalone-assets.mjs",
    "analyze": "next experimental-analyze --output",
    "build:ci": "npm run build && npm run prisma:seed",
    "start": "next start",
    "admin:insights": "tsx scripts/admin-insights.ts",
    "admin:prod": "scripts/admin-insights-prod.sh",
    "analytics:backfill": "tsx scripts/backfill-analytics.ts",
    "billing:reconcile-product-grants": "tsx scripts/reconcile-product-plan-grants.ts",
    "release:image": "scripts/release-image.sh",
    "worker": "tsx bin/shipyard-worker.ts",
    "images:ingest-external": "tsx scripts/ingest-external-images-to-r2.ts",
    "images:ingest-external:apply": "tsx scripts/ingest-external-images-to-r2.ts --apply",
    "browsers:update": "npx update-browserslist-db@latest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tools",
    "typecheck:diagnostics": "tsc --noEmit --extendedDiagnostics --pretty false",
    "typecheck:files": "tsc --noEmit --listFilesOnly --pretty false",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:dev": "tsx prisma/seed.dev.ts",
    "prisma:seed:categories": "tsx prisma/seed.categories.ts",
    "prisma:seed:usecases": "tsx prisma/seed.use-cases.ts",
    "prisma:seed:plan-features": "tsx prisma/seed.plan-features.ts",
    "prisma:seed:plans": "tsx prisma/seed.plans.ts",
    "prisma:seed:alternatives": "tsx prisma/seed.alternatives.ts",
    "prisma:seed:prod": "npm run prisma:seed:categories && npm run prisma:seed:usecases && npm run prisma:seed:plan-features",
    "postinstall": "npm run prisma:deploy",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@clerk/nextjs": "^7.5.12",
    "@dualmark/converters": "^0.10.0",
    "@dualmark/core": "^0.10.0",
    "@dualmark/nextjs": "^0.10.0",
    "@grafana/faro-web-sdk": "^2.8.2",
    "@grafana/faro-web-tracing": "^2.8.2",
    "@hookform/resolvers": "^5.4.0",
    "@next/env": "^16.3.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@pyroscope/nodejs": "^0.4.13",
    "@radix-ui/react-accordion": "^1.2.15",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tabler/icons-react": "^3.44.0",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dodopayments": "^2.40.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.23.0",
    "next": "^16.3.6",
    "next-seo": "^7.2.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "prisma": "^7.10.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "react-is": "19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.1",
    "redis": "^6.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.6",
    "tsx": "^4.22.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
