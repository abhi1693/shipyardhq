// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/vendor/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  tagline            String
  description        String
  websiteUrl         String
  logo               String
  userId             String
  categoryId         String
  planId             String?
  planAssignedAt     DateTime?
  type               ProductType
  pricingModel       PricingModel
  status             ProductStatus @default(published)
  publishedAt        DateTime?
  organizationId     String?
  startingPriceCents Int?
  currencyCode       String? // ISO 4217, e.g. "USD"
  ctaLabel           String?
  ctaUrl             String?
  bannerImage        String?
  keywords           String[]
  platforms          Platform[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user                  User                    @relation(fields: [userId], references: [id])
  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  plan                  Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  organization          Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  metadata              ProductMetadata?
  analytics             ProductAnalytics?
  verification          ProductVerification?
  insightProfile        ProductInsightProfile?
  ProductBadge          ProductBadge[]
  ProductMedia          ProductMedia[]
  ProductUpvote         ProductUpvote[]
  ProductReview         ProductReview[]
  ProductUpdate         ProductUpdate[]
  placementSchedules    PlacementSchedule[]
  clickEvents           ProductClickEvent[]
  trafficEvents         ProductTrafficEvent[]
  MonthlyProductRanking MonthlyProductRanking[]
  rewardTransactions    RewardTransaction[]
  redemptions           Redemption[]
  featureEntitlements   FeatureEntitlement[]

  @@index([categoryId, createdAt])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model MonthlyProductRanking {
  id        String   @id @default(cuid())
  productId String
  month     DateTime // Normalized to the first day of the month in UTC
  rank      Int
  score     Int?
  upvotes   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([month, productId])
  @@unique([month, rank])
  @@index([productId, month])
  @@index([month])
  @@index([createdAt])
  @@index([updatedAt])
}

model MonthlyLeaderboardNotification {
  id        String   @id @default(cuid())
  month     DateTime @unique // normalized month date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductType {
  saas
  browser_extension
  mobile_app
  desktop_app
  api
  open_source
  other
}

enum PricingModel {
  free
  freemium
  subscription
  one_time
  custom
}

enum ProductStatus {
  draft
  published
  archived
}

enum ProductUpdateStatus {
  draft
  published
}

enum ProductInsightStatus {
  pending
  ready
  failed
}

enum Platform {
  web
  ios
  android
  mac
  windows
  linux
  chrome_extension
  firefox_extension
}

model ProductMedia {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  imageUrl  String
  altText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductUpdate {
  id          String              @id @default(cuid())
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  title       String
  summary     String?
  content     String
  status      ProductUpdateStatus @default(published)
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([productId, status])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductVerification {
  id                    String    @id @default(cuid())
  productId             String    @unique
  verificationTxt       String
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  backlinkIsVerified    Boolean   @default(false)
  backlinkVerifiedAt    DateTime?
  backlinkLastCheckedAt DateTime?
  backlinkFoundUrl      String?
  backlinkLastError     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductMetadata {
  id           String   @id @default(cuid())
  productId    String   @unique
  githubUrl    String?
  twitterUrl   String?
  demoUrl      String?
  contactEmail String?
  utmCampaign  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String   @unique
  upvotes   Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([upvotes])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductClickEvent {
  id        String         @id @default(cuid())
  productId String
  referrer  String?
  userAgent String?
  device    DeviceCategory @default(unknown)
  browser   String?
  os        String?
  country   String?
  region    String?
  city      String?
  ipHash    String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
}

enum DeviceCategory {
  desktop
  mobile
  tablet
  unknown
}

model ProductTrafficEvent {
  id        String         @id @default(cuid())
  productId String
  path      String
  referrer  String?
  userAgent String?
  device    DeviceCategory @default(unknown)
  browser   String?
  os        String?
  country   String?
  region    String?
  city      String?
  ipHash    String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([country])
  @@index([device])
}

model ProductInsightProfile {
  id                     String               @id @default(cuid())
  productId              String               @unique
  status                 ProductInsightStatus @default(pending)
  errorMessage           String?              @db.Text
  lastRunAt              DateTime?
  insightsGeneratedCount Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  product Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stages  ProductInsightStageResult[]

  @@index([status])
  @@index([updatedAt])
}

model ProductInsightStageResult {
  id           String               @id @default(cuid())
  profileId    String
  stageId      String
  providerType String
  status       ProductInsightStatus @default(pending)
  data         Json?
  metrics      Json?
  errorMessage String?              @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  profile ProductInsightProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, stageId, providerType])
  @@index([profileId, stageId])
  @@index([status])
  @@index([updatedAt])
}

model ProductUpvote {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt])
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  url         String                   @unique
  ownerUserId String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]

  Product Product[]

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([updatedAt])
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  jobTitle       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([createdAt])
  @@index([updatedAt])
}

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique
  email        String     @unique
  firstName    String
  lastName     String
  role         String     @default("member")
  roleIntent   String? // Why they signed up
  heardFrom    String? // How they heard about us
  status       UserStatus @default(active)
  onboardedAt  DateTime?
  suspendedAt  DateTime?
  terminatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[]
  memberships             OrganizationMembership[]
  ProductUpvote           ProductUpvote[]
  productReviews          ProductReview[]
  Organization            Organization[]
  feedback                MemberFeedback[]
  purchases               UserPlanPurchase[]
  rewardBalance           RewardBalance?
  rewardTransactions      RewardTransaction[]      @relation("RewardUserTransactions")
  rewardTransactionsActed RewardTransaction[]      @relation("RewardTransactionActor")
  redemptions             Redemption[]
  featureEntitlements     FeatureEntitlement[]
  productUpdates          ProductUpdate[]

  @@index([status])
  @@index([roleIntent])
  @@index([heardFrom])
  @@index([onboardedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum UserStatus {
  active
  suspended
  terminated
}

enum FeedbackStatus {
  received
  in_review
  closed
}

enum RewardTransactionType {
  earn
  spend
  adjustment
  refund
}

enum RedemptionStatus {
  pending
  active
  expired
  canceled
  failed
  refunded
}

enum PlacementStatus {
  pending
  scheduled
  active
  completed
  canceled
  failed
}

enum RewardRuleCategory {
  engagement
  streak
  admin
  system
  bonus
}

enum RewardFeatureCategory {
  placement
  analytics
  insights
  access
  exposure
  utility
}

enum FeatureSubjectType {
  user
  product
  organization
  global
}

enum FeatureEntitlementStatus {
  pending
  active
  paused
  expired
  canceled
  failed
}

model MemberFeedback {
  id              String         @id @default(cuid())
  userId          String
  subject         String?
  message         String
  rating          Int?
  status          FeedbackStatus @default(received)
  adminNote       String?
  rewardEligible  Boolean        @default(false)
  rewardGrantedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] // reverse relation
  useCases UseCaseCategory[]

  @@index([createdAt])
  @@index([updatedAt])
}

model Plan {
  id                         String        @id @default(cuid())
  externalId                 String?       @unique
  name                       String
  slug                       String        @unique
  description                String?
  type                       PlanType
  price                      Int // in cents
  discount                   Float? // percentage
  boostForDays               Int           @default(1) // how long the boost applies (1-30 days)
  isDefault                  Boolean       @default(false)
  // Recurring pricing fields (used when type = recurring_price)
  paymentFrequencyCount      Int?
  paymentFrequencyInterval   TimeInterval?
  subscriptionPeriodCount    Int?
  subscriptionPeriodInterval TimeInterval?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  products    Product[]
  assignments PlanFeatureAssignment[]
  purchases   UserPlanPurchase[]

  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeature {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments       PlanFeatureAssignment[]
  RewardCatalogItem RewardCatalogItem[]

  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeatureAssignment {
  id             String   @id @default(cuid())
  planId         String
  featureId      String
  enabled        Boolean
  isExperimental Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan    Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId]) // Prevent duplicate assignments
  @@index([enabled])
  @@index([createdAt])
  @@index([updatedAt])
}

enum PlanType {
  one_time_price
  recurring_price
}

// Common interval units for recurring pricing and subscription periods
enum TimeInterval {
  day
  week
  month
  year
}

model UserPlanPurchase {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  // External transaction/subscription identifier from the payment provider
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductBadge {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  badge     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([badge])
  @@index([createdAt])
  @@index([updatedAt])
}

model UseCase {
  id        String   @id @default(cuid())
  label     String // e.g. "Launch a SaaS"
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories UseCaseCategory[]

  @@index([createdAt])
  @@index([updatedAt])
}

model UseCaseCategory {
  useCaseId  String
  categoryId String

  useCase  UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([useCaseId, categoryId])
}

model RewardBalance {
  userId              String    @id
  balance             Int       @default(0)
  lifetimeEarned      Int       @default(0)
  lifetimeSpent       Int       @default(0)
  lifetimeAdjusted    Int       @default(0)
  lifetimeRefunded    Int       @default(0)
  currentStreakCount  Int       @default(0)
  longestStreakCount  Int       @default(0)
  currentStreakTier   String?
  streakActiveThrough DateTime?
  lastEarnedAt        DateTime?
  lastRedeemedAt      DateTime?
  lastAdjustmentAt    DateTime?
  lastEvaluatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@index([updatedAt])
}

model RewardRule {
  id                       String             @id @default(cuid())
  key                      String             @unique
  name                     String
  description              String?
  category                 RewardRuleCategory
  baseRewardAmount         Int
  isActive                 Boolean            @default(true)
  dailyCap                 Int?
  lifetimeCap              Int?
  globalCooldownSeconds    Int?
  perTargetCooldownSeconds Int?
  metadata                 Json?
  tierConfig               Json?
  adminNotes               String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  transactions RewardTransaction[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardCatalogItem {
  id                String                @id @default(cuid())
  featureKey        String                @unique
  planFeatureKey    String?
  name              String
  description       String?
  category          RewardFeatureCategory
  baseCost          Int
  durationSeconds   Int?
  isActive          Boolean               @default(true)
  maxActivePerUser  Int?
  maxPendingPerUser Int?
  requiresProduct   Boolean               @default(false)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  planFeature        PlanFeature?         @relation(fields: [planFeatureKey], references: [key], onDelete: SetNull)
  redemptions        Redemption[]
  entitlements       FeatureEntitlement[]
  transactions       RewardTransaction[]
  placementSchedules PlacementSchedule[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          RewardTransactionType
  rewardAmount  Int
  balanceAfter  Int
  ruleId        String?
  ruleKey       String?
  rewardKey     String?
  redemptionId  String?
  productId     String?
  eventId       String?
  eventHash     String?
  sourceType    String?
  sourceId      String?
  targetType    String?
  targetId      String?
  notes         String?
  metadata      Json?
  actedByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user        User               @relation("RewardUserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  rule        RewardRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem? @relation(fields: [rewardKey], references: [featureKey], onDelete: SetNull)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  actedBy     User?              @relation("RewardTransactionActor", fields: [actedByUserId], references: [id], onDelete: SetNull)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([eventHash])
  @@index([userId, createdAt])
  @@index([type])
  @@index([ruleKey])
  @@index([rewardKey])
  @@index([productId])
  @@index([eventId])
}

model Redemption {
  id              String           @id @default(cuid())
  userId          String
  featureKey      String
  productId       String?
  status          RedemptionStatus @default(pending)
  cost            Int
  originalCost    Int
  refundedRewards Int              @default(0)
  startsAt        DateTime?
  activatedAt     DateTime?
  expiresAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem    @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions       RewardTransaction[]
  entitlements       FeatureEntitlement[]
  placementSchedules PlacementSchedule[]

  @@index([userId, status])
  @@index([featureKey])
  @@index([productId])
  @@index([createdAt])
}

model FeatureEntitlement {
  id            String                   @id @default(cuid())
  userId        String
  featureKey    String
  redemptionId  String?
  productId     String?
  subjectType   FeatureSubjectType       @default(user)
  subjectId     String?
  status        FeatureEntitlementStatus @default(pending)
  startsAt      DateTime?
  activatedAt   DateTime?
  expiresAt     DateTime?
  deactivatedAt DateTime?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem   @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  redemption         Redemption?         @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  placementSchedules PlacementSchedule[]

  @@index([userId, featureKey, status])
  @@index([featureKey, status])
  @@index([productId, status])
  @@index([subjectType, subjectId])
}

model PlacementSchedule {
  id                String          @id @default(cuid())
  entitlementId     String
  redemptionId      String?
  featureKey        String
  productId         String
  slotKey           String
  status            PlacementStatus @default(pending)
  startsAt          DateTime
  endsAt            DateTime
  activationJobId   String?
  deactivationJobId String?
  inventoryToken    String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  entitlement FeatureEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem  @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([slotKey, startsAt])
  @@index([status])
  @@index([productId, startsAt])
  @@index([featureKey, status])
}

model EventEnvelope {
  id                String                @id @default(cuid())
  event             String
  payload           Json
  asyncHandlers     String[]
  pendingHandlers   String[]
  status            EventEnvelopeStatus   @default(pending)
  attempts          Int                   @default(0)
  lastError         String?
  enqueuedAt        DateTime              @default(now())
  processingStarted DateTime?
  processedAt       DateTime?
  nextRunAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  attemptsLog EventAttempt[]

  @@index([status, nextRunAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model EventAttempt {
  id          String             @id @default(cuid())
  envelopeId  String
  handler     String
  status      EventAttemptStatus
  durationMs  Int?
  error       String?
  attempt     Int
  createdAt   DateTime           @default(now())

  envelope EventEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, createdAt])
}

enum EventEnvelopeStatus {
  pending
  processing
  retrying
  completed
  dead_letter
}

enum EventAttemptStatus {
  succeeded
  failed
  timed_out
}
