// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/vendor/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  tagline            String
  description        String
  websiteUrl         String
  logo               String
  userId             String
  categoryId         String
  planId             String?
  planAssignedAt     DateTime?
  type               ProductType
  pricingModel       PricingModel
  status             ProductStatus @default(published)
  publishedAt        DateTime?
  organizationId     String?
  startingPriceCents Int?
  currencyCode       String? // ISO 4217, e.g. "USD"
  ctaLabel           String?
  ctaUrl             String?
  bannerImage        String?
  keywords           String[]
  platforms          Platform[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user          User                  @relation(fields: [userId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  plan          Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  metadata      ProductMetadata?
  analytics     ProductAnalytics?
  verification  ProductVerification?
  ProductBadge  ProductBadge[]
  ProductMedia  ProductMedia[]
  ProductUpvote ProductUpvote[]
  trafficEvents ProductTrafficEvent[]

  @@index([categoryId, createdAt])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductType {
  saas
  browser_extension
  mobile_app
  desktop_app
  api
  open_source
  other
}

enum PricingModel {
  free
  freemium
  subscription
  one_time
  custom
}

enum ProductStatus {
  draft
  published
  archived
}

enum Platform {
  web
  ios
  android
  mac
  windows
  linux
  chrome_extension
  firefox_extension
}

model ProductMedia {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  imageUrl  String
  altText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVerification {
  id              String    @id @default(cuid())
  productId       String    @unique
  verificationTxt String
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductMetadata {
  id           String   @id @default(cuid())
  productId    String   @unique
  githubUrl    String?
  twitterUrl   String?
  demoUrl      String?
  contactEmail String?
  utmCampaign  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String   @unique
  upvotes   Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([upvotes])
}

enum DeviceCategory {
  desktop
  mobile
  tablet
  unknown
}

model ProductTrafficEvent {
  id        String         @id @default(cuid())
  productId String
  path      String
  referrer  String?
  userAgent String?
  device    DeviceCategory @default(unknown)
  browser   String?
  os        String?
  country   String?
  region    String?
  city      String?
  ipHash    String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([country])
  @@index([device])
}

model ProductUpvote {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  url         String                   @unique
  ownerUserId String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]

  Product Product[]

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  jobTitle       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model User {
  id              String     @id @default(cuid())
  clerkId         String     @unique
  email           String     @unique
  firstName       String
  lastName        String
  role            String     @default("member")
  roleIntent      String? // Why they signed up
  heardFrom       String? // How they heard about us
  acceptedTerms   Boolean    @default(false)
  termsAcceptedAt DateTime?
  status          UserStatus @default(active)
  suspendedAt     DateTime?
  terminatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  memberships   OrganizationMembership[]
  ProductUpvote ProductUpvote[]
  Organization  Organization[]
  purchases     UserPlanPurchase[]
}

enum UserStatus {
  active
  suspended
  terminated
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] // reverse relation
  useCases UseCaseCategory[]
}

model Plan {
  id                         String        @id @default(cuid())
  externalId                 String?       @unique
  name                       String
  slug                       String        @unique
  description                String?
  type                       PlanType
  price                      Int // in cents
  discount                   Float? // percentage
  boostForDays               Int           @default(1) // how long the boost applies (1-30 days)
  isDefault                  Boolean       @default(false)
  // Recurring pricing fields (used when type = recurring_price)
  paymentFrequencyCount      Int?
  paymentFrequencyInterval   TimeInterval?
  subscriptionPeriodCount    Int?
  subscriptionPeriodInterval TimeInterval?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  products    Product[]
  assignments PlanFeatureAssignment[]
  purchases   UserPlanPurchase[]

  @@index([type])
}

model PlanFeature {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments PlanFeatureAssignment[]
}

model PlanFeatureAssignment {
  id             String   @id @default(cuid())
  planId         String
  featureId      String
  enabled        Boolean
  isExperimental Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan    Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId]) // Prevent duplicate assignments
  @@index([enabled])
}

enum PlanType {
  one_time_price
  recurring_price
}

// Common interval units for recurring pricing and subscription periods
enum TimeInterval {
  day
  week
  month
  year
}

model UserPlanPurchase {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  // External transaction/subscription identifier from the payment provider
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
}

model ProductBadge {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  badge     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([badge])
}

model UseCase {
  id        String   @id @default(cuid())
  label     String // e.g. "Launch a SaaS"
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories UseCaseCategory[]
}

model UseCaseCategory {
  useCaseId  String
  categoryId String

  useCase  UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([useCaseId, categoryId])
}
