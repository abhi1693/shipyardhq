model ProductTrafficCityDaily {
  id             String              @id @default(cuid())
  productId      String
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  city           String              @default("Unknown")
  region         String              @default("Unknown")
  country        String              @default("Unknown")
  countryCode    String              @default("")
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([productId, date, source, city, region, country, countryCode])
  @@index([productId, date])
  @@index([city])
}

model SiteTrafficDaily {
  id                     String              @id @default(cuid())
  date                   DateTime
  source                 AnalyticsDataSource @default(ga4)
  pageViews              Int                 @default(0)
  uniqueVisitors         Int                 @default(0)
  sessions               Int                 @default(0)
  bounceRate             Float               @default(0)
  averageSessionDuration Float               @default(0)
  newUsers               Int                 @default(0)
  returningVisitors      Int                 @default(0)
  engagementRate         Float               @default(0)
  pagesPerSession        Float               @default(0)
  ingestionRunId         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source])
  @@index([date])
  @@index([source, date])
}

model SiteTrafficReferrerDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  referrer       String
  pageViews      Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, referrer])
  @@index([date])
  @@index([referrer])
}

model SiteTrafficBrowserDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  browser        String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, browser])
  @@index([date])
  @@index([browser])
}

model SiteTrafficOperatingSystemDaily {
  id              String              @id @default(cuid())
  date            DateTime
  source          AnalyticsDataSource @default(ga4)
  operatingSystem String
  visitors        Int                 @default(0)
  ingestionRunId  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, operatingSystem])
  @@index([date])
  @@index([operatingSystem])
}

model SiteTrafficDeviceDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  deviceCategory String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, deviceCategory])
  @@index([date])
  @@index([deviceCategory])
}

model SiteTrafficCountryDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  country        String
  countryCode    String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, country, countryCode])
  @@index([date])
  @@index([country])
}

model SiteTrafficRegionDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  region         String
  country        String
  countryCode    String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, region, country, countryCode])
  @@index([date])
  @@index([region])
}

model SiteTrafficCityDaily {
  id             String              @id @default(cuid())
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  city           String
  region         String
  country        String
  countryCode    String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([date, source, city, region, country, countryCode])
  @@index([date])
  @@index([city])
}

model ProductUpvote {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique
  email        String     @unique
  firstName    String
  lastName     String
  role         String     @default("member")
  roleIntent   String? // Why they signed up
  heardFrom    String? // How they heard about us
  status       UserStatus @default(active)
  onboardedAt  DateTime?
  suspendedAt  DateTime?
  terminatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[]
  productDrafts           ProductDraft[]
  ProductUpvote           ProductUpvote[]
  purchases               UserPlanPurchase[]
  rewardBalance           RewardBalance?
  rewardTransactions      RewardTransaction[]  @relation("RewardUserTransactions")
  rewardTransactionsActed RewardTransaction[]  @relation("RewardTransactionActor")
  redemptions             Redemption[]
  featureEntitlements     FeatureEntitlement[]

  @@index([status])
  @@index([roleIntent])
  @@index([heardFrom])
  @@index([onboardedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum UserStatus {
  active
  suspended
  terminated
}

enum RewardTransactionType {
  earn
  spend
  adjustment
  refund
}

enum RedemptionStatus {
  pending
  active
  expired
  canceled
  failed
  refunded
}

enum PlacementStatus {
  pending
  scheduled
  active
  completed
  canceled
  failed
}

enum RewardRuleCategory {
  engagement
  streak
  admin
  system
  bonus
}

enum RewardFeatureCategory {
  placement
  analytics
  insights
  access
  exposure
  utility
}

enum FeatureSubjectType {
  user
  product
  global
}

enum FeatureEntitlementStatus {
  pending
  active
  paused
  expired
  canceled
  failed
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products            Product[] // reverse relation
  productAssignments  ProductCategory[]
  useCases            UseCaseCategory[]
  alternativeProducts AlternativeProduct[] @relation("AlternativeProductCategories")

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@index([productId])
  @@index([createdAt])
}

model Plan {
  id                         String        @id @default(cuid())
  externalId                 String?       @unique
  name                       String
  slug                       String        @unique
  description                String?
  type                       PlanType
  price                      Int // in cents
  discount                   Float? // percentage
  boostForDays               Int           @default(1) // how long the boost applies (1-30 days)
  isDefault                  Boolean       @default(false)
  // Recurring pricing fields (used when type = recurring_price)
  paymentFrequencyCount      Int?
  paymentFrequencyInterval   TimeInterval?
  subscriptionPeriodCount    Int?
  subscriptionPeriodInterval TimeInterval?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  products    Product[]
  assignments PlanFeatureAssignment[]
  purchases   UserPlanPurchase[]

  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeature {
  id          String   @id @default(cuid())
  name        String
  displayName String?
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments       PlanFeatureAssignment[]
  RewardCatalogItem RewardCatalogItem[]

  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeatureAssignment {
  id             String   @id @default(cuid())
  planId         String
  featureId      String
  enabled        Boolean
  isExperimental Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan    Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId]) // Prevent duplicate assignments
  @@index([enabled])
  @@index([createdAt])
  @@index([updatedAt])
}

enum PlanType {
  one_time_price
  recurring_price
}

// Common interval units for recurring pricing and subscription periods
enum TimeInterval {
  day
  week
  month
  year
}

model UserPlanPurchase {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  // External transaction/subscription identifier from the payment provider
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductBadge {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  badge     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([badge])
  @@index([createdAt])
  @@index([updatedAt])
}

model UseCase {
  id        String   @id @default(cuid())
  label     String // e.g. "Launch a SaaS"
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories UseCaseCategory[]

  @@index([createdAt])
  @@index([updatedAt])
}

model UseCaseCategory {
  useCaseId  String
  categoryId String

  useCase  UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([useCaseId, categoryId])
}

model RewardBalance {
  userId              String    @id
  balance             Int       @default(0)
  lifetimeEarned      Int       @default(0)
  lifetimeSpent       Int       @default(0)
  lifetimeAdjusted    Int       @default(0)
  lifetimeRefunded    Int       @default(0)
  currentStreakCount  Int       @default(0)
  longestStreakCount  Int       @default(0)
  currentStreakTier   String?
  streakActiveThrough DateTime?
  lastEarnedAt        DateTime?
  lastRedeemedAt      DateTime?
  lastAdjustmentAt    DateTime?
  lastEvaluatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@index([updatedAt])
}

model RewardRule {
  id                       String             @id @default(cuid())
  key                      String             @unique
  name                     String
  description              String?
  category                 RewardRuleCategory
  baseRewardAmount         Int
  isActive                 Boolean            @default(true)
  dailyCap                 Int?
  lifetimeCap              Int?
  globalCooldownSeconds    Int?
  perTargetCooldownSeconds Int?
  metadata                 Json?
  tierConfig               Json?
  adminNotes               String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  transactions RewardTransaction[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardCatalogItem {
  id                String                @id @default(cuid())
  featureKey        String                @unique
  planFeatureKey    String?
  name              String
  description       String?
  category          RewardFeatureCategory
  baseCost          Int
  durationSeconds   Int?
  isActive          Boolean               @default(true)
  maxActivePerUser  Int?
  maxPendingPerUser Int?
  requiresProduct   Boolean               @default(false)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  planFeature        PlanFeature?         @relation(fields: [planFeatureKey], references: [key], onDelete: SetNull)
  redemptions        Redemption[]
  entitlements       FeatureEntitlement[]
  transactions       RewardTransaction[]
  placementSchedules PlacementSchedule[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          RewardTransactionType
  rewardAmount  Int
  balanceAfter  Int
  ruleId        String?
  ruleKey       String?
  rewardKey     String?
  redemptionId  String?
  productId     String?
  eventId       String?
  eventHash     String?
  sourceType    String?
  sourceId      String?
  targetType    String?
  targetId      String?
  notes         String?
  metadata      Json?
  actedByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user        User               @relation("RewardUserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  rule        RewardRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem? @relation(fields: [rewardKey], references: [featureKey], onDelete: SetNull)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  actedBy     User?              @relation("RewardTransactionActor", fields: [actedByUserId], references: [id], onDelete: SetNull)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([eventHash])
  @@index([userId, createdAt])
  @@index([type])
  @@index([ruleKey])
  @@index([userId, ruleKey, type, createdAt])
  @@index([userId, ruleKey, targetId, type, createdAt])
  @@index([rewardKey])
  @@index([productId])
  @@index([eventId])
}

model Redemption {
  id              String           @id @default(cuid())
  userId          String
  featureKey      String
  productId       String?
  status          RedemptionStatus @default(pending)
  cost            Int
  originalCost    Int
  refundedRewards Int              @default(0)
  startsAt        DateTime?
  activatedAt     DateTime?
  expiresAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem    @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions       RewardTransaction[]
  entitlements       FeatureEntitlement[]
  placementSchedules PlacementSchedule[]

  @@index([userId, status])
  @@index([featureKey])
  @@index([productId])
  @@index([createdAt])
}

model FeatureEntitlement {
  id            String                   @id @default(cuid())
  userId        String
  featureKey    String
  redemptionId  String?
  productId     String?
  subjectType   FeatureSubjectType       @default(user)
  subjectId     String?
  status        FeatureEntitlementStatus @default(pending)
  startsAt      DateTime?
  activatedAt   DateTime?
  expiresAt     DateTime?
  deactivatedAt DateTime?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem   @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  redemption         Redemption?         @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  placementSchedules PlacementSchedule[]

  @@index([userId, featureKey, status])
  @@index([featureKey, status])
  @@index([productId, status])
  @@index([subjectType, subjectId])
}

model PlacementSchedule {
  id                String          @id @default(cuid())
  entitlementId     String
  redemptionId      String?
  featureKey        String
  productId         String
  slotKey           String
  status            PlacementStatus @default(pending)
  startsAt          DateTime
  endsAt            DateTime
  activationJobId   String?
  deactivationJobId String?
  inventoryToken    String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  entitlement FeatureEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem  @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([slotKey, startsAt])
  @@index([status])
  @@index([productId, startsAt])
  @@index([featureKey, status])
}

model EventEnvelope {
  id                String              @id @default(cuid())
  event             String
  payload           Json
  asyncHandlers     String[]
  pendingHandlers   String[]
  status            EventEnvelopeStatus @default(pending)
  attempts          Int                 @default(0)
  lastError         String?
  enqueuedAt        DateTime            @default(now())
  processingStarted DateTime?
  processedAt       DateTime?
  queue             String              @default("default")
  nextRunAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  attemptsLog EventAttempt[]

  @@index([status, nextRunAt])
  @@index([queue, status, nextRunAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model EventAttempt {
  id         String             @id @default(cuid())
  envelopeId String
  handler    String
  status     EventAttemptStatus
  durationMs Int?
  error      String?
  attempt    Int
  createdAt  DateTime           @default(now())

  envelope EventEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, createdAt])
}

enum EventEnvelopeStatus {
  pending
  processing
  retrying
  completed
  dead_letter
}

enum EventAttemptStatus {
  succeeded
  failed
  timed_out
}
