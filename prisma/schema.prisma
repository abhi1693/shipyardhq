model ProductTrafficDeviceDaily {
  id             String              @id @default(cuid())
  productId      String
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  deviceCategory String
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([productId, date, source, deviceCategory])
  @@index([productId, date])
  @@index([deviceCategory])
}

model ProductTrafficCountryDaily {
  id             String              @id @default(cuid())
  productId      String
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  country        String              @default("Unknown")
  countryCode    String              @default("")
  visitors       Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([productId, date, source, country, countryCode])
  @@index([productId, date])
  @@index([country])
