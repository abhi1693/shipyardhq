// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Product {
  id         String   @id @default(cuid())
  name       String
  tagline    String
  websiteUrl String
  logo       String
  userId     String
  categoryId String
  planId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user         User                 @relation(fields: [userId], references: [id])
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  plan         Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  metadata     ProductMetadata?
  analytics    ProductAnalytics?
  verification ProductVerification?
}

model ProductVerification {
  id              String    @id @default(cuid())
  productId       String    @unique
  verificationTxt String
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductMetadata {
  id           String  @id @default(cuid())
  productId    String  @unique
  githubUrl    String?
  twitterUrl   String?
  demoUrl      String?
  contactEmail String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAnalytics {
  id        String @id @default(cuid())
  productId String @unique
  views     Int    @default(0)
  upvotes   Int    @default(0)
  clicks    Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] // reverse relation
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] // reverse relation
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  type        PlanType
  price       Int // in cents
  interval    String // e.g. "month"
  frequency   Int // e.g. 1 (monthly), 12 (yearly)
  discount    Int? // optional discount in cents
  trialDays   Int? // optional number of trial days
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  features PlanFeature[]
  products Product[]
}

model PlanFeature {
  id             String  @id @default(cuid())
  key            String
  enabled        Boolean
  isExperimental Boolean @default(false)
  planId         String

  plan Plan @relation(fields: [planId], references: [id])
}

enum PlanType {
  recurring
}
