// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/vendor/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  tagline            String
  description        String
  websiteUrl         String
  logo               String
  userId             String
  categoryId         String
  planId             String?
  planAssignedAt     DateTime?
  type               ProductType
  pricingModel       PricingModel
  status             ProductStatus @default(published)
  publishedAt        DateTime?
  startingPriceCents Int?
  currencyCode       String? // ISO 4217, e.g. "USD"
  bannerImage        String?
  keywords           String[]
  platforms          Platform[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user                  User                    @relation(fields: [userId], references: [id])
  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  plan                  Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  metadata              ProductMetadata?
  analytics             ProductAnalytics?
  verification          ProductVerification?
  ProductBadge          ProductBadge[]
  ProductMedia          ProductMedia[]
  ProductUpvote         ProductUpvote[]
  placementSchedules    PlacementSchedule[]
  leaderboardScores     ProductLeaderboardScore[]
  rewardTransactions    RewardTransaction[]
  redemptions           Redemption[]
  featureEntitlements   FeatureEntitlement[]
  alternatives          AlternativeProduct[] @relation("ProductAlternativeProducts")
  paymentConnector      PaymentConnector?
  claimAttempts         ProductClaimAttempt[]

  @@index([categoryId, createdAt])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum PaymentConnectorProvider {
  dodo
  abacatepay
  polar
  stripe
  lemonsqueezy
  paddle
  paystack
  revenuecat
  creem
}

enum PaymentConnectorStatus {
  active
  disabled
  error
}

enum PaymentCredentialStatus {
  active
  revoked
  expired
}

model PaymentConnector {
  id                        String                  @id @default(cuid())
  productId                 String
  provider                  PaymentConnectorProvider
  status                    PaymentConnectorStatus  @default(active)
  config                    Json?
  lastSyncedAt              DateTime?
  lastSyncError             String?
  verifiedAt                DateTime?
  latestAllTimeRevenueCents Int?
  latestCurrencyCode        String?
  latestPeriodStart         DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  product        Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  credentials    PaymentConnectorCredential[]
  revenueHistory PaymentRevenueSnapshot[]

  @@unique([productId])
  @@index([productId, updatedAt])
  @@index([status, updatedAt])
}

model PaymentConnectorCredential {
  id                 String                 @id @default(cuid())
  connectorId        String
  status             PaymentCredentialStatus @default(active)
  encryptionVersion  Int                    @default(1)
  encryptedKey       String
  keyHint            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  connector PaymentConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, status])
  @@index([createdAt])
}

model PaymentRevenueSnapshot {
  id                     String                   @id @default(cuid())
  connectorId            String
  currencyCode           String
  periodStart            DateTime
  periodRevenueCents     Int                      @default(0)
  allTimeRevenueCents    Int                      @default(0)
  data                   Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  connector PaymentConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, periodStart, currencyCode])
  @@index([connectorId, periodStart])
  @@index([createdAt])
}

model AlternativeProduct {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  websiteUrl  String      @unique
  logoUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[] @relation("ProductAlternativeProducts")
  categories Category[] @relation("AlternativeProductCategories")

  @@index([createdAt])
  @@index([updatedAt])
}

enum LeaderboardRunStatus {
  pending
  processing
  finalized
}

model LeaderboardRun {
  id           String               @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  status       LeaderboardRunStatus @default(pending)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  scores ProductLeaderboardScore[]

  @@unique([periodStart, periodEnd])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductLeaderboardScore {
  id                String   @id @default(cuid())
  runId             String
  productId         String
  views             Int      @default(0)
  uniqueVisitors    Int      @default(0)
  upvotes           Int      @default(0)
  score             Int      @default(0)
  scoreComponents   Json?
  rank              Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  run     LeaderboardRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([runId, productId])
  @@index([runId, rank])
  @@index([runId, score])
  @@index([createdAt])
  @@index([updatedAt])
}

model MonthlyLeaderboardNotification {
  id        String   @id @default(cuid())
  month     DateTime @unique // normalized month date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductType {
  saas
  browser_extension
  mobile_app
  desktop_app
  api
  open_source
  other
}

enum PricingModel {
  free
  freemium
  subscription
  one_time
  custom
}

enum ProductStatus {
  draft
  published
  archived
}

enum Platform {
  web
  ios
  android
  mac
  windows
  linux
  chrome_extension
  firefox_extension
}

model ProductMedia {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  imageUrl  String
  altText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductClaimMethod {
  dns
  email_otp
}

enum ProductClaimStatus {
  pending
  fulfilled
  expired
  cancelled
  failed
}

model ProductVerification {
  id                    String    @id @default(cuid())
  productId             String    @unique
  verificationTxt       String
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  backlinkIsVerified    Boolean   @default(false)
  backlinkVerifiedAt    DateTime?
  backlinkLastCheckedAt DateTime?
  backlinkFoundUrl      String?
  backlinkLastError     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductClaimAttempt {
  id           String              @id @default(cuid())
  productId    String
  userId       String
  method       ProductClaimMethod
  status       ProductClaimStatus  @default(pending)
  email        String?
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([userId, status])
}

model ProductMetadata {
  id           String   @id @default(cuid())
  productId    String   @unique
  githubUrl    String?
  twitterUrl   String?
  demoUrl      String?
  contactEmail String?
  utmCampaign  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String   @unique
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([upvotes])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductUpvote {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt])
}

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique
  email        String     @unique
  firstName    String
  lastName     String
  role         String     @default("member")
  roleIntent   String? // Why they signed up
  heardFrom    String? // How they heard about us
  status       UserStatus @default(active)
  onboardedAt  DateTime?
  suspendedAt  DateTime?
  terminatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[]
  ProductUpvote           ProductUpvote[]
  feedback                MemberFeedback[]
  purchases               UserPlanPurchase[]
  rewardBalance           RewardBalance?
  rewardTransactions      RewardTransaction[]      @relation("RewardUserTransactions")
  rewardTransactionsActed RewardTransaction[]      @relation("RewardTransactionActor")
  redemptions             Redemption[]
  featureEntitlements     FeatureEntitlement[]
  productClaimAttempts    ProductClaimAttempt[]

  @@index([status])
  @@index([roleIntent])
  @@index([heardFrom])
  @@index([onboardedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

enum UserStatus {
  active
  suspended
  terminated
}

enum FeedbackStatus {
  received
  in_review
  closed
}

enum RewardTransactionType {
  earn
  spend
  adjustment
  refund
}

enum RedemptionStatus {
  pending
  active
  expired
  canceled
  failed
  refunded
}

enum PlacementStatus {
  pending
  scheduled
  active
  completed
  canceled
  failed
}

enum RewardRuleCategory {
  engagement
  streak
  admin
  system
  bonus
}

enum RewardFeatureCategory {
  placement
  analytics
  insights
  access
  exposure
  utility
}

enum FeatureSubjectType {
  user
  product
  global
}

enum FeatureEntitlementStatus {
  pending
  active
  paused
  expired
  canceled
  failed
}

model MemberFeedback {
  id              String         @id @default(cuid())
  userId          String
  subject         String?
  message         String
  rating          Int?
  status          FeedbackStatus @default(received)
  adminNote       String?
  rewardEligible  Boolean        @default(false)
  rewardGrantedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products            Product[] // reverse relation
  useCases            UseCaseCategory[]
  alternativeProducts AlternativeProduct[] @relation("AlternativeProductCategories")

  @@index([createdAt])
  @@index([updatedAt])
}

model Plan {
  id                         String        @id @default(cuid())
  externalId                 String?       @unique
  name                       String
  slug                       String        @unique
  description                String?
  type                       PlanType
  price                      Int // in cents
  discount                   Float? // percentage
  boostForDays               Int           @default(1) // how long the boost applies (1-30 days)
  isDefault                  Boolean       @default(false)
  // Recurring pricing fields (used when type = recurring_price)
  paymentFrequencyCount      Int?
  paymentFrequencyInterval   TimeInterval?
  subscriptionPeriodCount    Int?
  subscriptionPeriodInterval TimeInterval?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  products    Product[]
  assignments PlanFeatureAssignment[]
  purchases   UserPlanPurchase[]

  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeature {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments       PlanFeatureAssignment[]
  RewardCatalogItem RewardCatalogItem[]

  @@index([createdAt])
  @@index([updatedAt])
}

model PlanFeatureAssignment {
  id             String   @id @default(cuid())
  planId         String
  featureId      String
  enabled        Boolean
  isExperimental Boolean  @default(false)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan    Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId]) // Prevent duplicate assignments
  @@index([enabled])
  @@index([createdAt])
  @@index([updatedAt])
}

enum PlanType {
  one_time_price
  recurring_price
}

// Common interval units for recurring pricing and subscription periods
enum TimeInterval {
  day
  week
  month
  year
}

model UserPlanPurchase {
  id         String   @id @default(cuid())
  userId     String
  planId     String
  // External transaction/subscription identifier from the payment provider
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductBadge {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  badge     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([badge])
  @@index([createdAt])
  @@index([updatedAt])
}

model UseCase {
  id        String   @id @default(cuid())
  label     String // e.g. "Launch a SaaS"
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories UseCaseCategory[]

  @@index([createdAt])
  @@index([updatedAt])
}

model UseCaseCategory {
  useCaseId  String
  categoryId String

  useCase  UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([useCaseId, categoryId])
}

model RewardBalance {
  userId              String    @id
  balance             Int       @default(0)
  lifetimeEarned      Int       @default(0)
  lifetimeSpent       Int       @default(0)
  lifetimeAdjusted    Int       @default(0)
  lifetimeRefunded    Int       @default(0)
  currentStreakCount  Int       @default(0)
  longestStreakCount  Int       @default(0)
  currentStreakTier   String?
  streakActiveThrough DateTime?
  lastEarnedAt        DateTime?
  lastRedeemedAt      DateTime?
  lastAdjustmentAt    DateTime?
  lastEvaluatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@index([updatedAt])
}

model RewardRule {
  id                       String             @id @default(cuid())
  key                      String             @unique
  name                     String
  description              String?
  category                 RewardRuleCategory
  baseRewardAmount         Int
  isActive                 Boolean            @default(true)
  dailyCap                 Int?
  lifetimeCap              Int?
  globalCooldownSeconds    Int?
  perTargetCooldownSeconds Int?
  metadata                 Json?
  tierConfig               Json?
  adminNotes               String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  transactions RewardTransaction[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardCatalogItem {
  id                String                @id @default(cuid())
  featureKey        String                @unique
  planFeatureKey    String?
  name              String
  description       String?
  category          RewardFeatureCategory
  baseCost          Int
  durationSeconds   Int?
  isActive          Boolean               @default(true)
  maxActivePerUser  Int?
  maxPendingPerUser Int?
  requiresProduct   Boolean               @default(false)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  planFeature        PlanFeature?         @relation(fields: [planFeatureKey], references: [key], onDelete: SetNull)
  redemptions        Redemption[]
  entitlements       FeatureEntitlement[]
  transactions       RewardTransaction[]
  placementSchedules PlacementSchedule[]

  @@index([category])
  @@index([isActive])
  @@index([updatedAt])
}

model RewardTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          RewardTransactionType
  rewardAmount  Int
  balanceAfter  Int
  ruleId        String?
  ruleKey       String?
  rewardKey     String?
  redemptionId  String?
  productId     String?
  eventId       String?
  eventHash     String?
  sourceType    String?
  sourceId      String?
  targetType    String?
  targetId      String?
  notes         String?
  metadata      Json?
  actedByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user        User               @relation("RewardUserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  rule        RewardRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem? @relation(fields: [rewardKey], references: [featureKey], onDelete: SetNull)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  actedBy     User?              @relation("RewardTransactionActor", fields: [actedByUserId], references: [id], onDelete: SetNull)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([eventHash])
  @@index([userId, createdAt])
  @@index([type])
  @@index([ruleKey])
  @@index([userId, ruleKey, type, createdAt])
  @@index([userId, ruleKey, targetId, type, createdAt])
  @@index([rewardKey])
  @@index([productId])
  @@index([eventId])
}

model Redemption {
  id              String           @id @default(cuid())
  userId          String
  featureKey      String
  productId       String?
  status          RedemptionStatus @default(pending)
  cost            Int
  originalCost    Int
  refundedRewards Int              @default(0)
  startsAt        DateTime?
  activatedAt     DateTime?
  expiresAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem    @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions       RewardTransaction[]
  entitlements       FeatureEntitlement[]
  placementSchedules PlacementSchedule[]

  @@index([userId, status])
  @@index([featureKey])
  @@index([productId])
  @@index([createdAt])
}

model FeatureEntitlement {
  id            String                   @id @default(cuid())
  userId        String
  featureKey    String
  redemptionId  String?
  productId     String?
  subjectType   FeatureSubjectType       @default(user)
  subjectId     String?
  status        FeatureEntitlementStatus @default(pending)
  startsAt      DateTime?
  activatedAt   DateTime?
  expiresAt     DateTime?
  deactivatedAt DateTime?
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem        RewardCatalogItem   @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  redemption         Redemption?         @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  placementSchedules PlacementSchedule[]

  @@index([userId, featureKey, status])
  @@index([featureKey, status])
  @@index([productId, status])
  @@index([subjectType, subjectId])
}

model PlacementSchedule {
  id                String          @id @default(cuid())
  entitlementId     String
  redemptionId      String?
  featureKey        String
  productId         String
  slotKey           String
  status            PlacementStatus @default(pending)
  startsAt          DateTime
  endsAt            DateTime
  activationJobId   String?
  deactivationJobId String?
  inventoryToken    String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  entitlement FeatureEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  redemption  Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  catalogItem RewardCatalogItem  @relation(fields: [featureKey], references: [featureKey], onDelete: Restrict)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([slotKey, startsAt])
  @@index([status])
  @@index([productId, startsAt])
  @@index([featureKey, status])
}

model EventEnvelope {
  id                String              @id @default(cuid())
  event             String
  payload           Json
  asyncHandlers     String[]
  pendingHandlers   String[]
  status            EventEnvelopeStatus @default(pending)
  attempts          Int                 @default(0)
  lastError         String?
  enqueuedAt        DateTime            @default(now())
  processingStarted DateTime?
  processedAt       DateTime?
  queue             String              @default("default")
  nextRunAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  attemptsLog EventAttempt[]

  @@index([status, nextRunAt])
  @@index([queue, status, nextRunAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model EventAttempt {
  id         String             @id @default(cuid())
  envelopeId String
  handler    String
  status     EventAttemptStatus
  durationMs Int?
  error      String?
  attempt    Int
  createdAt  DateTime           @default(now())

  envelope EventEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([envelopeId, createdAt])
}

enum EventEnvelopeStatus {
  pending
  processing
  retrying
  completed
  dead_letter
}

enum EventAttemptStatus {
  succeeded
  failed
  timed_out
}
