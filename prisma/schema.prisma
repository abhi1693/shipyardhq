generator client {
  provider = "prisma-client"
  output   = "../lib/vendor/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  tagline            String
  description        String
  websiteUrl         String
  logo               String
  userId             String
  categoryId         String
  planId             String?
  subscriptionId     String?       @unique
  planAssignedAt     DateTime?
  type               ProductType
  pricingModel       PricingModel
  status             ProductStatus @default(published)
  publishedAt        DateTime?
  startingPriceCents Int?
  currencyCode       String? // ISO 4217, e.g. "USD"
  bannerImage        String?
  keywords           String[]
  platforms          Platform[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user                    User                                 @relation(fields: [userId], references: [id])
  category                Category                             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categories              ProductCategory[]
  plan                    Plan?                                @relation(fields: [planId], references: [id], onDelete: SetNull)
  metadata                ProductMetadata?
  analytics               ProductAnalytics?
  trafficDaily            ProductTrafficDaily[]
  trafficReferrers        ProductTrafficReferrerDaily[]
  trafficChannels         ProductTrafficChannelDaily[]
  trafficBrowsers         ProductTrafficBrowserDaily[]
  trafficOperatingSystems ProductTrafficOperatingSystemDaily[]
  trafficDevices          ProductTrafficDeviceDaily[]
  trafficCountries        ProductTrafficCountryDaily[]
  trafficCities           ProductTrafficCityDaily[]
  verification            ProductVerification?
  ProductBadge            ProductBadge[]
  ProductMedia            ProductMedia[]
  ProductUpvote           ProductUpvote[]
  placementSchedules      PlacementSchedule[]
  leaderboardScores       ProductLeaderboardScore[]
  keywordIndex            ProductKeyword[]
  rewardTransactions      RewardTransaction[]
  redemptions             Redemption[]
  featureEntitlements     FeatureEntitlement[]
  alternatives            AlternativeProduct[]                 @relation("ProductAlternativeProducts")

  @@index([categoryId, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([categoryId, status, publishedAt])
  @@index([planId, status, createdAt])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductKeyword {
  productId        String
  keyword          String
  canonical        String
  hash             String
  slug             String
  productStatus    ProductStatus
  productUpdatedAt DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, keyword], map: "ProductKeyword_pkey")
  @@index([productStatus, slug], map: "ProductKeyword_productStatus_slug_idx")
  @@index([productStatus, hash], map: "ProductKeyword_productStatus_hash_idx")
  @@index([productStatus, keyword, productUpdatedAt(sort: Desc)], map: "ProductKeyword_productStatus_keyword_productUpdatedAt_idx")
}

model ProductDraft {
  id          String   @id @default(cuid())
  productId   String   @unique
  userId      String
  mode        String   @default("member")
  currentStep String   @default("configuration")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([currentStep])
  @@index([createdAt])
  @@index([updatedAt])
}

model AlternativeProduct {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  websiteUrl  String   @unique
  logoUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]  @relation("ProductAlternativeProducts")
  categories Category[] @relation("AlternativeProductCategories")

  @@index([createdAt])
  @@index([updatedAt])
}

enum LeaderboardRunStatus {
  pending
  processing
  finalized
}

model LeaderboardRun {
  id          String               @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      LeaderboardRunStatus @default(pending)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  scores ProductLeaderboardScore[]

  @@unique([periodStart, periodEnd])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProductLeaderboardScore {
  id              String   @id @default(cuid())
  runId           String
  productId       String
  views           Int      @default(0)
  uniqueVisitors  Int      @default(0)
  upvotes         Int      @default(0)
  score           Int      @default(0)
  scoreComponents Json?
  rank            Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run     LeaderboardRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([runId, productId])
  @@index([runId, rank])
  @@index([runId, score])
  @@index([createdAt])
  @@index([updatedAt])
}

enum ProductType {
  saas
  browser_extension
  mobile_app
  desktop_app
  api
  open_source
  other
}

enum PricingModel {
  free
  freemium
  subscription
  one_time
  custom
}

enum ProductStatus {
  draft
  published
  archived
}

enum Platform {
  web
  ios
  android
  mac
  windows
  linux
  chrome_extension
  firefox_extension
}

model ProductMedia {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  imageUrl  String
  altText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductVerification {
  id                    String    @id @default(cuid())
  productId             String    @unique
  verificationTxt       String
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  backlinkIsVerified    Boolean   @default(false)
  backlinkVerifiedAt    DateTime?
  backlinkLastCheckedAt DateTime?
  backlinkFoundUrl      String?
  backlinkLastError     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductMetadata {
  id           String   @id @default(cuid())
  productId    String   @unique
  githubUrl    String?
  twitterUrl   String?
  videoUrl     String?
  contactEmail String?
  utmCampaign  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String   @unique
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([upvotes])
  @@index([createdAt])
  @@index([updatedAt])
}

enum AnalyticsDataSource {
  ga4
}

enum AnalyticsIngestionStatus {
  pending
  processing
  completed
  failed
}

enum AnalyticsIngestionJob {
  product_traffic_daily
  product_traffic_breakdowns
  site_traffic_daily
  site_traffic_breakdowns
}

model AnalyticsIngestionRun {
  id          String                   @id @default(cuid())
  source      AnalyticsDataSource      @default(ga4)
  job         AnalyticsIngestionJob
  status      AnalyticsIngestionStatus @default(pending)
  windowStart DateTime
  windowEnd   DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  stats       Json?
  error       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  productTrafficDaily            ProductTrafficDaily[]
  productTrafficReferrers        ProductTrafficReferrerDaily[]
  productTrafficChannels         ProductTrafficChannelDaily[]
  productTrafficBrowsers         ProductTrafficBrowserDaily[]
  productTrafficOperatingSystems ProductTrafficOperatingSystemDaily[]
  productTrafficDevices          ProductTrafficDeviceDaily[]
  productTrafficCountries        ProductTrafficCountryDaily[]
  productTrafficCities           ProductTrafficCityDaily[]
  siteTrafficDaily               SiteTrafficDaily[]
  siteTrafficReferrers           SiteTrafficReferrerDaily[]
  siteTrafficBrowsers            SiteTrafficBrowserDaily[]
  siteTrafficOperatingSystems    SiteTrafficOperatingSystemDaily[]
  siteTrafficDevices             SiteTrafficDeviceDaily[]
  siteTrafficCountries           SiteTrafficCountryDaily[]
  siteTrafficRegions             SiteTrafficRegionDaily[]
  siteTrafficCities              SiteTrafficCityDaily[]

  @@unique([source, job, windowStart, windowEnd])
  @@index([status, createdAt])
  @@index([job, source, windowStart])
  @@index([windowStart, windowEnd])
}

model ProductTrafficDaily {
  id                     String              @id @default(cuid())
  productId              String
  date                   DateTime
  source                 AnalyticsDataSource @default(ga4)
  pageViews              Int                 @default(0)
  uniqueVisitors         Int                 @default(0)
  sessions               Int                 @default(0)
  bounceRate             Float               @default(0)
  averageSessionDuration Float               @default(0)
  newUsers               Int                 @default(0)
  returningVisitors      Int                 @default(0)
  engagementRate         Float               @default(0)
  pagesPerSession        Float               @default(0)
  ingestionRunId         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([productId, date, source])
  @@index([productId, date])
  @@index([date])
  @@index([source, date])
}

model ProductTrafficReferrerDaily {
  id             String              @id @default(cuid())
  productId      String
  date           DateTime
  source         AnalyticsDataSource @default(ga4)
  referrer       String
  pageViews      Int                 @default(0)
  ingestionRunId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingestionRun AnalyticsIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([productId, date, source, referrer])
  @@index([productId, date])
  @@index([referrer])
}

